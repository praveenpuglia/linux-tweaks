#!/bin/bash
# Rebuild the LED-patched intel_cvs for each newly installed kernel,
# and delete it when that kernel is removed.
case "$1" in
add)
	/usr/local/sbin/intel-cvs-led-build "$2" \
		|| echo "intel-cvs-led: build for $2 failed; stock intel_cvs (LED off) will load" >&2
	;;
remove)
	rm -f "/lib/modules/$2/updates/intel_cvs.ko"
	rmdir --ignore-fail-on-non-empty "/lib/modules/$2/updates" "/lib/modules/$2" 2>/dev/null
	;;
esac
exit 0
